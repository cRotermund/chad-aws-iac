# Copy to terraform.tfvars (gitignored) and set your values.

# Generate the key locally, then paste the PUBLIC key here:
#   ssh-keygen -t ed25519 -C game-servers -f ~/.ssh/chad-game-servers.pem
ssh_public_key = "ssh-ed25519 AAAA... game-servers"

# Your workstation IP as a /32 for SSH access.
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Existing Elastic IP allocation to bring under management (keeps the current public IP).
eip_allocation_id = "eipalloc-0440bfb93a0c4ce6d"

# Optional overrides:
# root_volume_size_gb = 16
# instance_type       = "m6a.xlarge"
